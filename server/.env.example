# Copy this file to .env and adjust the values for your setup.

# PostgreSQL connection string. This default matches the database in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5432/todo

# Used only by the test suite. Matches the test-db service in docker-compose.yml.
# The database name must end in "_test": the tests delete every row after each test.
TEST_DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5433/todo_test
