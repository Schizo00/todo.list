{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (dev)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--no-access-log"],
      "cwd": "${workspaceFolder}/server",
      "python": "${workspaceFolder}/server/.venv/bin/python",
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "Start database"
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/server",
      "python": "${workspaceFolder}/server/.venv/bin/python",
      "justMyCode": false,
      "preLaunchTask": "Start test database"
    }
  ]
}
